{
  "name": "switchyard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "start": "tsx server/index.ts --production",
    "test:browser": "playwright test",
    "test:operator": "vitest run src/operator server",
    "test:live": "tsx scripts/live-smoke.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:live:design": "tsx scripts/design-live-smoke.ts",
    "test:live:recovery": "tsx scripts/autopilot-live-smoke.ts"
  },
  "dependencies": {
    "lucide-react": "1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.0",
    "tsx": "4.23.13",
    "@playwright/test": "1.63.0"
  },
  "license": "MIT",
  "description": "Breakscale with a JEV operator: build it, break it, and watch it recover.",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamrajjoshi/switchyard.git"
  },
  "engines": {
    "node": ">=24"
  }
}
